{
  "manifest_version": 3,
  "name": "1132 Fixer for Chrome",
  "short_name": "1132 Fixer",
  "version": "1.1.0",
  "description": "One-click Zoom site-data cleaner. Clears Zoom cookies, storage, cache, and IndexedDB, then reloads the active Zoom tab.",
  "author": "Justyn Gunnels",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "1132 Fixer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "cookies",
    "browsingData",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.zoom.us/*",
    "https://*.zoom.com/*"
  ]
}
